# Luvr Web App — Environment Variables
# Copy this to .env.local for local development.
# Set these in Vercel: Project Settings → Environment Variables

# ── Site URL (your Vercel URL or custom domain) ──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://luvr-nine.vercel.app

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API

# Public anon key (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (SERVER ONLY — never expose to the browser)
# Used for admin operations (e.g. creating profiles after signup)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
