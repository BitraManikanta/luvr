# Luvora API – environment variables
# Copy to .env.local for local development. NEVER commit .env.local.

NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=luvora
DB_PASSWORD=luvora_dev
DB_NAME=luvora

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — change these to long, random strings in production
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=luvora-media
S3_REGION=us-east-1

# Optional: FCM / APNs for push notifications (Phase 8)
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
